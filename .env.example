# Assistant IA (serveur uniquement — ne jamais préfixer avec VITE_)
# Copier ce fichier vers .env et renseigner la clé.

# google | openrouter
AI_PROVIDER=openrouter

# Clé API Google (AIza…) ou OpenRouter (sk-or-v1-…)
# Attention : pas d'espace ni de ":" avant la clé
AI_API_KEY=

# Exemples OpenRouter free :
#   nemotron-3-ultra-550b-a55b:free
#   google/gemini-2.0-flash-exp:free
# Exemple Google :
#   gemini-3.8-flash
AI_MODEL=nemotron-3-ultra-550b-a55b:free

# Supabase (catalogue + Storage product-media)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Upload scripts: npm run storage:upload:covers | npm run storage:upload
