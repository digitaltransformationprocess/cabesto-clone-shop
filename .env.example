# Assistant IA (serveur uniquement — ne jamais préfixer avec VITE_)
# Copier ce fichier vers .env et renseigner la clé.

# google | openrouter
AI_PROVIDER=openrouter

# Clé API Google (AIza…) ou OpenRouter (sk-or-v1-…)
# Attention : pas d'espace ni de ":" avant la clé
AI_API_KEY=

# Exemples OpenRouter free :
#   nvidia/nemotron-3-super-120b-a12b:free
#   openrouter/free   (routeur — bascule si un free est saturé)
#   cohere/north-mini-code:free
#   dots-studio/dots-3-note-preview:free
# Exemple Google :
#   gemini-3.8-flash
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Supabase (catalogue + Storage product-media)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only — RAG indexer / match_product_chunks (jamais VITE_)
SUPABASE_SERVICE_ROLE_KEY=
# Embeddings (OpenRouter). Default: openai/text-embedding-3-small (1536 dims)
# EMBEDDING_MODEL=openai/text-embedding-3-small
# Upload / RAG scripts:
#   npm run storage:upload:covers | npm run storage:upload
#   npm run rag:index:dry | npm run rag:index
#   npm run rag:index:docs:dry | npm run rag:index:docs
# RAG chat (serveur) : POST /api/chat  — produits + docs site, SSE, service_role + AI_API_KEY
