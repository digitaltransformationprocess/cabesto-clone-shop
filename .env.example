# Assistant IA (exposé au navigateur via Vite — ok pour démo ; ne pas utiliser une clé prod sensible)
# google | openrouter
AI_PROVIDER=openrouter

# Clé API Google (AIza…) ou OpenRouter (sk-or-v1-…)
AI_API_KEY=

# Exemples OpenRouter free :
#   nemotron-3-ultra-550b-a55b:free
#   google/gemini-2.0-flash-exp:free
AI_MODEL=nemotron-3-ultra-550b-a55b:free

# Alias optionnels (équivalent)
# VITE_AI_PROVIDER=
# VITE_AI_API_KEY=
# VITE_AI_MODEL=

# Supabase (catalogue + Storage product-media)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Scripts locaux (upload) :
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
